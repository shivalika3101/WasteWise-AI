# Copy to .env and adjust before running `docker compose up --build`.
# These are consumed by the root docker-compose.yml for all three services.

POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=waste_app

# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=local-dev-secret-change-me-please-32chars
